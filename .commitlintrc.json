{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [1, "always", ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"]],
    "scope-enum": [
      1,
      "always",
      [
        "api",
        "model",
        "sim",
        "ui",
        "docker",
        "ci",
        "docs",
        "rules",
        "preprocess"
      ]
    ],
    "subject-case": [0],
    "body-max-line-length": [1, "always", 100],
    "footer-max-line-length": [1, "always", 100]
  }
}
