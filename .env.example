# Salin ke .env lalu ganti nilainya. Nilai di bawah HANYA untuk pengembangan lokal.
POSTGRES_USER=coldtrack
POSTGRES_PASSWORD=ganti-saya
POSTGRES_DB=coldtrack
MQTT_INGEST_PASSWORD=ganti-saya-ingest
MQTT_SIMULATOR_PASSWORD=ganti-saya-simulator
# Kecepatan simulator truk virtual (1 = waktu nyata, 60 = 1 jam per menit)
SIM_SPEED=30
