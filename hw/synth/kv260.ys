# Sintesis Yosys untuk KV260 (Zynq UltraScale+, keluarga xcup). Perkiraan resource; timing resmi lewat Vivado.
read_verilog -sv rtl/sha256_core.sv rtl/seal.sv rtl/physics.sv rtl/floor_div.sv rtl/features.sv rtl/tree_engine.sv rtl/sha256_stream.sv rtl/qspi_reader.sv rtl/tree_stream.sv rtl/model_flash.sv rtl/coldtrack_top.sv
chparam -set BERKAS_SIMPUL "model/xgb_v5_context_duty/nodes.mem" -set BERKAS_POHON "model/xgb_v5_context_duty/trees.mem" -set BERKAS_BASE "model/xgb_v5_context_duty/base.mem" coldtrack_top
synth_xilinx -family xcup -top coldtrack_top
tee -o build/util_coldtrack_top.txt stat
